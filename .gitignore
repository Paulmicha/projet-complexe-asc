
##
# Local git work tree gardening.
#
# Uses ASC.
# @link https://github.com/Paulmicha/asc
# @license Apache-2.0 license
# @see README.md
#

# Separate git repos in subdirs (CWT_APPS)
/app

# Excluded environment global variables and other files generated by ASC.
/.env
/.env-local*
/compose.yml
/compose.override.yml
/docker-compose.yml
/docker-compose.override.yml
/scripts/asc/local/*
!/scripts/asc/local/README.md

# Instance data, logs, etc.
/data/asc/*
!/data/asc/README.md

/data/db/*
!/data/db/README.md

/data/db-dumps/*
!/data/db-dumps/README.md

/data/files/*
!/data/files/README.md

/data/private/*
!/data/private/README.md

/data/tmp/*
!/data/tmp/README.md

/data/logs/*
!/data/logs/README.md

/data/threads/*
!/data/threads/README.md

/data/loops/*
!/data/loops/README.md

/data/cronjobs/*
!/data/cronjobs/README.md

/data/changes/*

!/data/changes/agent
/data/changes/agent/*

!/data/changes/agent/accepted
/data/changes/agent/accepted/*
!/data/changes/agent/accepted/README.md

!/data/changes/agent/iterate
/data/changes/agent/iterate/*
!/data/changes/agent/iterate/README.md

!/data/changes/agent/rejected
/data/changes/agent/rejected/*
!/data/changes/agent/rejected/README.md

!/data/changes/agent/review
/data/changes/agent/review/*
!/data/changes/agent/review/README.md

!/data/changes/human
/data/changes/human/*

!/data/changes/human/inbox
/data/changes/human/inbox/*
!/data/changes/human/inbox/README.md

# Misc.
docker-runtime
.idea
__pycache__/
*.py[cod]
*.sql
.DS_Store
._*
.bash_aliases
*.sshconfig
